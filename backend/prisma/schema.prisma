generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  avatarUrl     String?
  isActive      Boolean   @default(true)
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  creator       Creator?
  donor         Donor?
  comments      Comment[]
  reports       Report[]

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String     @id @default(uuid())
  name        RoleName   @unique
  description String?
  createdAt   DateTime   @default(now())

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

model RefreshToken {
  id          String    @id @default(uuid())
  token       String    @unique
  userId      String
  expiresAt   DateTime
  isRevoked   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  replacedBy  String?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// CORE DOMAIN
// ─────────────────────────────────────────────

model Creator {
  id           String    @id @default(uuid())
  userId       String    @unique
  bio          String?
  websiteUrl   String?
  socialLinks  Json?
  isVerified   Boolean   @default(false)
  totalRaised  Decimal   @default(0) @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@index([userId])
  @@map("creators")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  iconUrl     String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  campaigns   Campaign[]

  @@index([slug])
  @@map("categories")
}

model Campaign {
  id              String           @id @default(uuid())
  creatorId       String
  categoryId      String
  title           String
  slug            String           @unique
  description     String
  story           String           @db.Text
  goalAmount      Decimal          @db.Decimal(12, 2)
  raisedAmount    Decimal          @default(0) @db.Decimal(12, 2)
  currency        String           @default("USD")
  status          CampaignStatus   @default(DRAFT)
  coverImageUrl   String?
  videoUrl        String?
  startDate       DateTime?
  endDate         DateTime?
  donorsCount     Int              @default(0)
  donationsCount  Int              @default(0)
  viewsCount      Int              @default(0)
  isFeatured      Boolean          @default(false)
  allowAnonymous  Boolean          @default(true)
  minDonation     Decimal?         @db.Decimal(10, 2)
  maxDonation     Decimal?         @db.Decimal(10, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  creator         Creator          @relation(fields: [creatorId], references: [id])
  category        Category         @relation(fields: [categoryId], references: [id])
  rewards         Reward[]
  donations       Donation[]
  updates         Update[]
  comments        Comment[]
  reports         Report[]

  @@index([creatorId])
  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@index([deletedAt])
  @@map("campaigns")
}

model Reward {
  id              String      @id @default(uuid())
  campaignId      String
  title           String
  description     String
  minimumAmount   Decimal     @db.Decimal(10, 2)
  estimatedDelivery DateTime?
  maxClaims       Int?
  claimsCount     Int         @default(0)
  isAvailable     Boolean     @default(true)
  imageUrl        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  campaign        Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donations       Donation[]

  @@index([campaignId])
  @@map("rewards")
}

model Donor {
  id            String      @id @default(uuid())
  userId        String      @unique
  totalDonated  Decimal     @default(0) @db.Decimal(12, 2)
  donationsCount Int        @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  donations     Donation[]

  @@index([userId])
  @@map("donors")
}

model Donation {
  id            String          @id @default(uuid())
  campaignId    String
  donorId       String?
  rewardId      String?
  amount        Decimal         @db.Decimal(10, 2)
  currency      String          @default("USD")
  isAnonymous   Boolean         @default(false)
  message       String?
  status        DonationStatus  @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  campaign      Campaign        @relation(fields: [campaignId], references: [id])
  donor         Donor?          @relation(fields: [donorId], references: [id])
  reward        Reward?         @relation(fields: [rewardId], references: [id])
  payment       Payment?

  @@index([campaignId])
  @@index([donorId])
  @@index([status])
  @@index([createdAt])
  @@map("donations")
}

model Payment {
  id                String        @id @default(uuid())
  donationId        String        @unique
  externalId        String?       @unique
  provider          String
  amount            Decimal       @db.Decimal(10, 2)
  currency          String
  status            PaymentStatus @default(PENDING)
  gatewayResponse   Json?
  refundedAt        DateTime?
  refundAmount      Decimal?      @db.Decimal(10, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  donation          Donation      @relation(fields: [donationId], references: [id])

  @@index([donationId])
  @@index([status])
  @@map("payments")
}

model Update {
  id          String    @id @default(uuid())
  campaignId  String
  title       String
  content     String    @db.Text
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("updates")
}

model Comment {
  id          String    @id @default(uuid())
  campaignId  String
  userId      String
  parentId    String?
  content     String
  likesCount  Int       @default(0)
  isHidden    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[] @relation("CommentReplies")
  reports     Report[]

  @@index([campaignId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

model Report {
  id          String        @id @default(uuid())
  reporterId  String
  campaignId  String?
  commentId   String?
  reason      ReportReason
  description String?
  status      ReportStatus  @default(PENDING)
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime      @default(now())

  reporter    User          @relation(fields: [reporterId], references: [id])
  campaign    Campaign?     @relation(fields: [campaignId], references: [id])
  comment     Comment?      @relation(fields: [commentId], references: [id])

  @@index([reporterId])
  @@index([status])
  @@map("reports")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum RoleName {
  ADMIN
  CREATOR
  DONOR
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  REJECTED
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum ReportReason {
  SPAM
  FRAUD
  INAPPROPRIATE_CONTENT
  MISLEADING
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}
